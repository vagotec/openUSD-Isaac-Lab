#usda 1.0
# Documentation: 01_03 - Properties
# Goal: Distinguish attributes from relationships.
# Key concepts:
# - Attribute: Stores typed data on a prim.
# - Relationship: Stores target paths to other objects.
# - Get: Reads a composed attribute value.



# Goal:
# Explore OpenUSD concepts in the 03 properties lesson.
(
    defaultPrim = "World"
    upAxis = "Z"
)

def Xform "World"
{
    def Cube "Box_A"
    {
        double size = 2

        double3 xformOp:translate = (1, 1, 1)

        uniform token[] xformOpOrder = [
            "xformOp:translate"
        ]

        color3f[] primvars:displayColor = [
            (0.2, 0.5, 0.9)
        ]

        rel target = </World/Box_B>

        rel connections = [
            </World/Box_B>,
            </World/Box_C>
        ]
    }

    def Cube "Box_B"
    {
        double size = 3
        double3 xformOp:translate = (4, 1.5, 1.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        color3f[] primvars:displayColor = [
            (0.9, 0.3, 0.2)
        ]
    }

    def Cube "Box_C"
    {
        double size = 1

        double3 xformOp:translate = (6.5, 0.5, 0.5)

        uniform token[] xformOpOrder = [
            "xformOp:translate"
        ]

        color3f[] primvars:displayColor = [
            (0.2, 0.8, 0.3)
        ]
    }
}
