#usda 1.0
# Documentation: 03_01 - Prim Hierarchy
# Goal: Understand parent-child relationships between prims.
# Key concepts:
# - Prim path: Identifies a prim within the scene hierarchy.
# - Parent: The prim containing a child prim.
# - Child: A prim nested beneath another prim.



# Goal:
# Explore OpenUSD concepts in the 03 hierarchy lesson.
(
    defaultPrim = "World"
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Robot"
    {
        double3 xformOp:translate = (4, 0, 0)

        uniform token[] xformOpOrder = [
            "xformOp:translate"
        ]

        def Cube "Body"
        {
            double size = 2

            double3 xformOp:translate = (0, 0, 1)

            uniform token[] xformOpOrder = [
                "xformOp:translate"
            ]

            color3f[] primvars:displayColor = [
                (0.2, 0.5, 0.9)
            ]
        }

        def Sphere "Head"
        {
            double radius = 0.75

            double3 xformOp:translate = (0, 0, 3)

            uniform token[] xformOpOrder = [
                "xformOp:translate"
            ]

            color3f[] primvars:displayColor = [
                (0.9, 0.4, 0.1)
            ]
        }
    }
}
